msgstr "<a id=\"io-formats-ja-c\"></a>"

#: ../../how-to/io_formats.md:199 c1eceaa7b4254a4bbe346184784418e7
msgid "C. General Analysis and Exchange"
msgstr "C. 汎用・解析用"

#: ../../how-to/io_formats.md:201 0929ddfcb06a4df9afe25f78e605f151
msgid ""
"These formats are useful for analysis notebooks, interchange, and general "
"storage. The key rule here is not to mix up “format choice” with “library "
"conversion.”"
msgstr ""
"解析ノート、外部解析、交換に向いた形式です。 このグループでは「保存形式として選ぶ話」と「他ライブラリへ変換する話」を混ぜないのが重要です。"

#: ../../how-to/io_formats.md:16 1d68756d8c5c426eb7bdc6bc1bdfa29d
msgid "**CSV** (`.csv`)"
msgstr ""

#: ../../how-to/io_formats.md:16 67fcca17b71a49bc90d02b71f1774a15
msgid ""
"`TimeSeries.read(\"data.csv\")`, `TimeSeriesDict.read(\"data.csv\")`, "
"`TimeSeriesDict.write(..., format=\"csv\")`"
msgstr ""

#: ../../how-to/io_formats.md:16 8b16e34430824504929ece2e9bb59ac5
msgid "Lightweight exchange and inspection"
msgstr "軽量な交換、目視確認"

#: ../../how-to/io_formats.md:16 d9f80eeb6f77442e937bd0fb7d994af8
msgid "Auto-identifies `.csv`; simple CSV exchange is metadata-light"
msgstr "`.csv` は自動判定されます。単純な CSV 交換は metadata-light です"

#: ../../how-to/io_formats.md:16 1011a2b641d54cd2a0b095dd305f358a
msgid "**TXT** (`.txt`)"
msgstr ""

#: ../../how-to/io_formats.md:16 6b605bab203346bb9b24de5a52c9f9b2
msgid ""
"`TimeSeries.read(..., format=\"txt\")`, `TimeSeriesDict.read(dir, "
"format=\"txt\")`, `TimeSeriesDict.write(dir, format=\"txt\")`"
msgstr ""

#: ../../how-to/io_formats.md:16 92cdce39514547098e78bbc9325997e4
msgid "Plain-text exchange"
msgstr "プレーンテキスト交換"

#: ../../how-to/io_formats.md:16 2a441a6b537946acaa363ab946104d1f
msgid "**nc** (`.nc`)"
msgstr ""

#: ../../how-to/io_formats.md:16 944d2a22652d44fa8a9d5553bbd4bd15
