msgstr "**コヒーレンスマップ**: 空間的なコヒーレンスの可視化"

#: ../../how-to/containers/field_scalar_intro.ipynb:330002
#: 313a16b7090e42dfb6f6f01db2cfaffa
msgid "Power Spectral Density (PSD)"
msgstr "パワースペクトル密度 (PSD)"

#: ../../how-to/containers/field_scalar_intro.ipynb:330004
