#: e7c2686a0e60497dbfe1aeb4b6e74a0f
msgid "Description"
msgstr "説明"

#: ../../how-to/fitting/advanced_decomposition.ipynb
#: fb5dfb89078d43769bbe16e2cdfbb1a7
msgid "`.standardize(method='zscore')`"
msgstr ""

