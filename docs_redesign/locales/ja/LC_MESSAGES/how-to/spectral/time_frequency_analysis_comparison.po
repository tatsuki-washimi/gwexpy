#: ../../how-to/spectral/time_frequency_analysis_comparison.ipynb:20002
#: 10b3692c6fcf4ae284608c5162dfc5d0
msgid "**Compression / features**"
msgstr "**圧縮／特徴抽出**"

#: ../../how-to/spectral/time_frequency_analysis_comparison.ipynb:20002
#: 3f369b975aa54e7d8ff1288325977927
msgid "DCT"
msgstr ""

#: ../../how-to/spectral/time_frequency_analysis_comparison.ipynb:20002
#: 7e86fd7722ff40ddbf5031d0604d1644
