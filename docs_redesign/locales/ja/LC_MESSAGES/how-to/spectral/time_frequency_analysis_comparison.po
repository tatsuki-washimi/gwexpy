#: ../../how-to/spectral/time_frequency_analysis_comparison.ipynb:50008
#: 78716d219b5d405983bca2f3ac170094
msgid "**Exponential ringdown** (120 Hz, τ=0.5s)"
msgstr "**指数減衰リングダウン**（120 Hz、τ=0.5 秒）"

#: ../../how-to/spectral/time_frequency_analysis_comparison.ipynb:50009
#: ef22fd3d48c745b3b943414fcaee1c8f
msgid "**Weak echo** (50ms delay)"
msgstr "**弱いエコー**（50 ms 遅延）"

#: ../../how-to/spectral/time_frequency_analysis_comparison.ipynb:50010
#: 14f89ff755cc4bc5b23874acf9b4d71f
msgid "**Smooth trend** (5 Hz modulation)"
msgstr "**滑らかなトレンド**（5 Hz 変調）"

#: ../../how-to/spectral/time_frequency_analysis_comparison.ipynb:50012
#: 0db995b2fe97401fb701a2508bc54db1
