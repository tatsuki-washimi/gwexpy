msgstr "以下を含む合成信号を作成します："

#: ../../how-to/spectral/time_frequency_analysis_comparison.ipynb:50005
#: a48d6305675d4cafb54e0ea8882cf61a
msgid "**Quasi-stationary tones** (50 Hz, 100 Hz)"
msgstr "**準定常トーン**（50 Hz、100 Hz）"

#: ../../how-to/spectral/time_frequency_analysis_comparison.ipynb:50006
#: ac1d575a07cf4672a81818da468ee2c5
msgid "**Linear chirp** (20→150 Hz)"
msgstr "**線形チャープ**（20→150 Hz）"

#: ../../how-to/spectral/time_frequency_analysis_comparison.ipynb:50007
#: 4d298ee453b8489aa4ca1c9793e1c795
