msgstr ""

#: ../../how-to/spectral/time_frequency_analysis_comparison.ipynb:20002
#: 26ec40540f374635bc3af90503aba34d
msgid "Precise frequency curve, no time-freq uncertainty"
msgstr "正確な周波数曲線、時間周波数の不確定性なし"

#: ../../how-to/spectral/time_frequency_analysis_comparison.ipynb:20002
#: 4c6e2870305b415da76a682bf1e9e55c
