msgid "This installs additional dependencies:"
msgstr "これにより、以下の追加の依存パッケージがインストールされます："

#: ../../how-to/gui.md:23 3a25fee4220d428f980f9a7bbc09b241
msgid "`PyQt5` - GUI framework"
msgstr "`PyQt5` - GUI フレームワーク"

#: ../../how-to/gui.md:24 bd44939c51b743bc83a619562b436dff
