#: 520d01c21b4048dcadaf1eedbef95b2f
msgid ""
"ASCII header with metadata (channel names, sample rate, local timestamp, "
"amplitude ranges)"
msgstr "メタデータを含む ASCII ヘッダー（チャンネル名、サンプリングレート、ローカル時刻、振幅レンジ等）"

#: ../../how-to/case-studies/case_gbd_format.ipynb:10010
#: 1f1ff179be52499ea51de0519f2c9a8a
