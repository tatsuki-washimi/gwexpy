msgstr "バイナリデータブロック（モデルにより float32 または int16）"

#: ../../how-to/case-studies/case_gbd_format.ipynb:10011
#: 8564aba6bd834da9a6cf014d58734aec
msgid "Multi-channel recording (up to 32 channels simultaneously)"
msgstr "マルチチャンネル記録（最大 32 チャンネル同時記録）"

#: ../../how-to/case-studies/case_gbd_format.ipynb:10012
#: dabf54ec6ddf43fca6ab0ddc4fbeca16
msgid "Optional digital (logic) channels"
msgstr "任意のデジタル（ロジック）チャンネル"

