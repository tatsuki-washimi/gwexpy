msgid "1.1 Imports and Parameters"
msgstr "1.1 インポートとパラメータ"

#: ../../how-to/case-studies/case_bootstrap_gls_fitting.ipynb:50002
#: 0441aa9e1ebd4c58912950536ac9a7cd
msgid "1.2 Generate Colored Noise + Resonant Peak"
msgstr "1.2 カラードノイズ + 共振ピークの生成"

#: ../../how-to/case-studies/case_bootstrap_gls_fitting.ipynb:50004
