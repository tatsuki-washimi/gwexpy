msgid "`qrange` — range of Q values to search (default: 4–64)"
msgstr "`qrange` — 探索する Q 値の範囲（デフォルト: 4〜64）"

#: ../../how-to/case-studies/case_glitch_analysis.ipynb:60009
#: d7e18556113b4502ba5e48aded9090b1
msgid "`frange` — frequency range in Hz"
msgstr "`frange` — 周波数範囲 [Hz]"

#: ../../how-to/case-studies/case_glitch_analysis.ipynb:60010
#: edac27ea271849e1b29ea5ae46d015b1
msgid "`mismatch` — fractional tile overlap (smaller = finer grid, slower)"
msgstr "`mismatch` — タイルオーバーラップの割合（小さいほど細かいグリッド）"

#: ../../how-to/case-studies/case_glitch_analysis.ipynb:80002
