msgid "Checkpoint Interrupt and Resume Verification"
msgstr "チェックポイントの中断と再開の検証"

#: ../../../home/washimi/work/gwexpy-worktrees/docs-remediation-20260916/docs_redesign/how-to/monitoring/chunked_long_data.ipynb:140002
