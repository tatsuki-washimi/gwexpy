#: ../../home/washimi/work/gwexpy/docs_redesign/explanation/ecosystem.md:106
#: cfc98fd3830d40378cb3c11820ff187f
msgid "veto production or search pipelines"
msgstr "veto の生成や探索パイプライン"

#: ../../home/washimi/work/gwexpy/docs_redesign/explanation/ecosystem.md:107
#: b23efe7d26714cb88a6b3e9192193fe8
msgid "trigger generators"
msgstr "トリガージェネレータ"

#: ../../home/washimi/work/gwexpy/docs_redesign/explanation/ecosystem.md:108
