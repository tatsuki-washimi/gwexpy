#: ../../home/washimi/work/gwexpy/docs_redesign/explanation/roadmap.md:20
#: 79b5734145f84bd8ac75a96867ba6953
msgid "Better notebook and tutorial reliability in CI"
msgstr "notebook / tutorial の CI 上での安定性向上"

#: ../../home/washimi/work/gwexpy/docs_redesign/explanation/roadmap.md:21
#: 1c1db4c7957c43d29c9905cd21404ea4
