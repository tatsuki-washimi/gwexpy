#: ../../about/changelog.md:3 566309ab9def469a87fadb8634137bdb
msgid "Notable changes to the GWexpy project."
msgstr "GWexpy の主な変更履歴を記載します。"

#: ../../about/changelog.md:5 6bc87e5f1c4d44f292b14fc21b913f57
msgid "[0.1.4] - 2026-05-14"
msgstr ""

#: ../../about/changelog.md:6 ../../about/changelog.md:47
